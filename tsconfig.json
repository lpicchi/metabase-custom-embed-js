{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/.tsbuildinfo",
    "paths": {
      "embedding-sdk-bundle/*": [
        "./src/frontend/src/embedding-sdk-bundle/*"
      ],
      "embedding-sdk-shared/*": [
        "./src/frontend/src/embedding-sdk-shared/*"
      ],
      "metabase/*": [
        "./src/frontend/src/metabase/*"
      ],
      "metabase-types/*": [
        "./src/frontend/src/metabase-types/*"
      ],
      "sdk-iframe-embedding-script-ee-plugins": [
        "./src/frontend/src/metabase/plugins/noop"
      ],
    },
  },
  "include": [
    "src/frontend/src/**/*.ts",
    "src/frontend/src/**/*.tsx",
    "src/loader.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}