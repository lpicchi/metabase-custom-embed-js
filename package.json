{
  "name": "custom-metabase-embed-js",
  "version": "1.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/metabase/loader.js",
  "module": "./dist/metabase/loader.js",
  "types": "./dist/metabase/loader.d.ts",
  "exports": {
    ".": {
      "types": "./dist/metabase/loader.d.ts",
      "import": "./dist/metabase/loader.js",
      "require": "./dist/metabase/loader.js"
    },
    "./embed": "./dist/metabase/embed.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/metabase/loader.js",
    "dist/metabase/loader.d.ts",
    "dist/metabase/embed.js",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/metabase/loader.js",
    "./dist/metabase/embed.js"
  ],
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve",
    "build": "cross-env NODE_ENV=production webpack --mode=production && yarn build:types",
    "build:types": "tsc -p tsconfig.build-types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "yarn build",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/plugin-syntax-import-assertions": "7.27.1",
    "@babel/plugin-transform-runtime": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@swc/core": "^1.16.2",
    "@types/icepick": "^2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/underscore": "^1",
    "babel-loader": "10.0.0",
    "cross-env": "10.1.0",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.104.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  },
  "dependencies": {
    "icepick": "2.4.0",
    "ts-pattern": "^5.9.0",
    "underscore": "^1.13.8"
  },
  "packageManager": "yarn@4.18.0"
}
